# ==========================================================
# ОБРАЗЕЦ блока .env для РЕАЛЬНОГО счёта (Gibrid-bot)
# Файл-шаблон, сам ничего не меняет. Значения вписать
# в C:\forexbot\.env на VPS, старые строки заменить.
# ==========================================================

# --- Торговый счёт: PU Prime LIVE ---
MT5_LOGIN=29399422
MT5_SERVER=PUPrime-Live
# ВНИМАНИЕ: старый пароль проходил через чат — сменить в кабинете PU Prime
# и вписать сюда НОВЫЙ. Пароль также нужно один раз ввести руками
# в терминале MT5 (галочка "Сохранить пароль") — MT5 не переносит его между машинами.
MT5_PASSWORD=<новый_пароль_после_смены>

# Путь к терминалу на VPS — фактический прод (подтверждён check_live 31.08:
# бот подключается именно к C:\MetaTrader5, счёт демо 700158875).
MT5_TERMINAL_PATH=C:\MetaTrader5\terminal64.exe

# --- Режим: витрина + сигналы переключаются одной переменной ---
# demo → сайт "ДЕМО-СЧЁТ", сигналы с тегом [ДЕМО]
# real → сайт "РЕАЛЬНЫЙ СЧЁТ", сигналы [LIVE], /status пишет "Режим: РЕАЛ"
TRADING_MODE=real

# --- Риск-база гибрида = фактический депозит ---
# От неё считаются лимит позиции (10%), корзины (25%) и дневной стоп (8%).
# При депозите $150 и базе 100 бот был бы осторожнее, чем нужно.
HYBRID_TEST_BALANCE=150
# Для XAUUSD: hard cap риска одной позиции 5% базы (цель 3-5%).
# XAUUSD live cap: 4% of the $150 risk base (about $6 per position).
HYBRID_XAU_MAX_POS_RISK_PCT=4
# Минимальные лоты брокера на live (check_live): XAU=0.01, NAS100=0.1, GER40=0.1.
HYBRID_LOT_OVERRIDES=NAS100.s=0.1,GER40.s=0.1

# --- Инструменты: ПОДСТАВИТЬ фактические имена с live-счёта ---
# На демо было: XAUUSD.s,NAS100.s,GER40.s
# На live суффиксы могут отличаться — точные имена печатает live\check_live.py
HYBRID_SYMBOLS=XAUUSD.s,NAS100.s,GER40.s

# --- Управление ботом: только владелец может /stop и /start ---
TELEGRAM_OWNER_ID=789368186

# --- Telegram: токен ПЕРЕВЫПУСТИТЬ у @BotFather (старый светился в чате) ---
TELEGRAM_BOT_TOKEN=<новый_токен_от_BotFather>
# Релей через крипто-VPS (обход блокировки api.telegram.org) — оставить как есть
TELEGRAM_API_BASE=https://trade.aliterra.space/tgrelay-fx99

# --- Трансляция сделок гибрида в канал (1=вкл) ---
HYBRID_CHANNEL_SIGNALS=1
HYBRID_SIGNAL_FILLS=1
HYBRID_SIGNAL_CLOSES=1

# ==========================================================
# КОПИТРЕЙДИНГ — заполнять ПОЗЖЕ, когда мастер отработает
# и появится второй реальный счёт + второй терминал MT5
# ==========================================================
# COPIER_DRY_RUN=1                  # 1 = только логи, ордера НЕ шлются
# COPIER_MASTERS=hybrid
# COPIER_LOGIN=<второй_счёт>
# COPIER_PASSWORD=<пароль_второго>
# COPIER_SERVER=PUPrime-Live
# COPIER_MT5_PATH=C:\MetaTrader5_copier\terminal64.exe   # ОТДЕЛЬНАЯ папка!
# COPIER_MASTER_BALANCE=150         # баланс мастера, от него масштаб лота
# COPIER_MAX_LOT=0.1
